(access_log) {
	log {
		output file /data/log/access.log {
			roll_size 50MiB
			roll_keep 3
		}
		format json
	}
}

http://127.0.0.1 {
	handle /edge-health {
		respond "ok" 200
	}
}

ledgesec.com, www.ledgesec.com {
	import access_log
	handle /edge-health {
		respond "ok" 200
	}
	handle {
		reverse_proxy web:8080
	}
}

dash.ledgesec.com, admin.ledgesec.com {
	import access_log
	handle /edge-health {
		respond "ok" 200
	}
	handle_path /api/* {
		reverse_proxy api:8080
	}
	handle {
		reverse_proxy web:8080
	}
}
