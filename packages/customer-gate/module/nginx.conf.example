# First customers. The request continues to the application.
# log_by_lua only records a line. A worker timer sends the batch.
# The secret is read from the environment or /etc/ledgesec/agent.env.
# env directives belong in the main context, or the worker never sees them.
env LEDGESEC_INGEST_SECRET;
# LEDGESEC_SITE_ID is the host from the admin cabinet. A site is the request Host.
env LEDGESEC_SITE_ID;
env LEDGESEC_EDGE_ID;
env LEDGESEC_INGEST_URL;
env LEDGESEC_SAMPLE_RATE;

http {
    lua_package_path "/usr/local/ledgesec/lua/?.lua;;";
    lua_shared_dict ledgesec_observe 16m;

    init_worker_by_lua_block {
        require("ledgesec.observe").start()
    }

    server {
        listen 443 ssl;
        server_name example.com;

        location / {
            log_by_lua_block {
                require("ledgesec.observe").note()
            }
            proxy_pass http://127.0.0.1:8080;
        }
    }
}
