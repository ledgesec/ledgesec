POSTGRES_PASSWORD=change-me
CLICKHOUSE_PASSWORD=change-me
# Shared by the customer module and the API. Leave empty until the first module is installed.
LEDGESEC_INGEST_SECRET=
# Signs the dashboard session. The admin is a row in Postgres, not a variable here.
LEDGESEC_SESSION_SECRET=
# On the European server leave these unset: the edge publishes 80 and 443.
# EDGE_HTTP_PORT=80
# EDGE_HTTPS_PORT=443
# Local project name only. Do not set this in Coolify.
# COMPOSE_PROJECT_NAME=ledgesec
# Local only. Leave unset on both servers so Caddy obtains a real certificate.
# CADDY_LOCAL_CERTS=1
